# Modo sincronizado (Supabase). Sem estas variáveis, o painel roda 100% local
# (localStorage), sem sincronizar. Com elas, liga o realtime entre dispositivos.
#
# Onde achar no Supabase: Project Settings > API.
# A chave anon é PÚBLICA, pode ir pro host e ser compartilhada. Nunca use a
# service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Senha de acesso ao painel (trava simples de interface). Se ficar vazia, o
# painel abre sem pedir senha.
VITE_APP_SENHA=defina-uma-senha
